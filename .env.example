# Witt Law — environment variables (all optional; analytics OFF unless set)
# Copy to .env.local for local dev, or set in Vercel project settings.

# Canonical production origin (used by SEO canonicals, sitemap, robots, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.lawyerstgeorge.com

# Analytics / verification — leave unset to keep everything off (F6).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CALLRAIL_ID=XXXXXXXXX/YYYYYYYY
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxx
# BING_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxx
